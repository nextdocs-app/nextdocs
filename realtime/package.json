{
  "name": "realtime",
  "type": "module",
  "version": "1.0.0",
  "description": "Realtime collaboration server for NextDocs document editor",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./types": {
      "import": "./dist/types/blocks.js",
      "require": "./dist/types/blocks.js",
      "types": "./dist/types/blocks.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@y/hub": "^0.10.1",
    "@y/y": "14.0.0-rc.30",
    "dotenv": "^18.0.10",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@y/websocket": "4.0.0-rc.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.73.0",
    "ws": "^8.23.0"
  }
}
