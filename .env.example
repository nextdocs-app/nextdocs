# --- Security ---

# Generate secure values with:
#   openssl rand -base64 32

# HMAC-SHA256 signing key for JWT access tokens (≥ 32 bytes required)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Base64-encoded AES key for OAuth token encryption at rest
# Must decode to 16 (AES-128), 24 (AES-192), or 32 (AES-256) bytes
OAUTH_TOKEN_ENCRYPTION_KEY_BASE64=CHANGE_ME_IN_PRODUCTION

# --- Database ---

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nextdocs
SPRING_DATASOURCE_USERNAME=nextdocs
SPRING_DATASOURCE_PASSWORD=nextdocs

# --- JWT expiry ---

JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# --- API (CORS & cookies) ---

# Defaults already cover localhost + LAN wildcards for phone testing, so you
# only need this override for custom domains or tunnel URLs.
# Example LAN override:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.7:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# --- Realtime service ---

# Defaults cover localhost and private LAN IPv4 ranges. Set this to override:
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.7:3000

# --- File attachments (self-hosted storage) ---

# Uploads live here — the only state outside Postgres. Back up with the DB.
# Single filesystem: share this path across API replicas (NFS/volume)
# or run 1 API replica, else downloads 404.
ATTACHMENT_STORAGE_PATH=./data/attachments

# Maximum size of a single uploaded file (Spring DataSize format: 25MB, 1GB, ...).
ATTACHMENT_MAX_FILE_SIZE=25MB
# Storage a single user may consume across all documents (2GB, 512MB, ...).
# Set -1 (or unlimited) to disable the cap while still tracking usage.
ATTACHMENT_MAX_STORAGE_PER_USER=2GB
# Multipart request limit; keep at or above ATTACHMENT_MAX_FILE_SIZE. Any reverse proxy in
# front of the API must allow at least this much (nginx: client_max_body_size 30m), or
# oversized requests fill the proxy's own request buffer before the API can refuse them.
ATTACHMENT_MAX_REQUEST_SIZE=30MB

# How long a signed attachment download URL stays valid (e.g. 20m, 1h, 7d).
# Kept short on purpose: the editor re-mints through /url on each render, which
# re-runs the permission check, so revocation takes effect within minutes.
ATTACHMENT_URL_TTL=20m

# HMAC key for attachment URL signatures, at least 32 bytes. When unset the JWT secret is
# used and a warning is logged at startup; set it explicitly to rotate attachment URLs
# independently. Must be identical across API instances and stable across restarts: restarting
# `./nd dev` without pinned secrets invalidates in-flight download URLs (clients re-mint
# automatically on the next render).
# ATTACHMENT_SIGNING_SECRET=

# Optional: absolute base URL when files are served from a separate host or CDN.
# ATTACHMENT_PUBLIC_BASE_URL=https://files.example.com

# --- Phone-on-LAN testing (web) ---
# Optional. When unset, the web app derives the API/realtime hosts from
# window.location.hostname, so http://<your-lan-ip>:3000 just works.
# Set these only to pin a host:
# NEXT_PUBLIC_API_URL=http://192.168.1.7:8080
# NEXT_PUBLIC_REALTIME_URL=ws://192.168.1.7:1234
