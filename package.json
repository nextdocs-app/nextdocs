{
  "name": "nextdocs-root",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.6.2"
  },
  "workspaces": [
    "web",
    "realtime"
  ],
  "scripts": {
    "check:lockfiles": "node scripts/check-workspace-lockfiles.js",
    "check:runtime-versions": "node scripts/check-runtime-versions.js",
    "verify": "node scripts/hooks.js verify",
    "verify:all": "node scripts/hooks.js verify --all",
    "format:root": "prettier --check package.json turbo.json tsconfig.base.json .prettierrc codecov.yml docker-compose.yml \".github/**/*.{yml,yaml}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" lint-staged.config.js",
    "format:root:fix": "prettier --write package.json turbo.json tsconfig.base.json .prettierrc codecov.yml docker-compose.yml \".github/**/*.{yml,yaml}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" lint-staged.config.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:scripts": "node --test \"scripts/**/*.test.js\"",
    "verify:instances": "node scripts/verify-instances.js",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:install": "playwright install chromium",
    "format": "turbo run format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "turbo": "^2"
  }
}
