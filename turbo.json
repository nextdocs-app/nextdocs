{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "JWT_SECRET",
    "YHUB_SERVICE_TOKEN",
    "YHUB_BASE_URL",
    "YHUB_WS_URL",
    "YHUB_PURGE_INTERVAL_MS",
    "REDIS",
    "POSTGRES",
    "API_BASE_URL",
    "PORT",
    "CORS_ORIGIN",
    "CORS_ALLOWED_ORIGINS",
    "CORS_ORIGINS",
    "NODE_ENV",
    "MAX_DOC_SIZE_BYTES",
    "SWEEP_INTERVAL_MS",
    "MAX_RECHECK_DOCS",
    "LOG_LEVEL",
    "RECHECK_CONCURRENCY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "test": {},
    "format": { "cache": false },
    "format:fix": { "cache": false },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
